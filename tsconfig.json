{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./app/*"],
      "next/link": ["./server/shims/next-link.tsx"],
      "next/image": ["./server/shims/next-image.tsx"],
      "next/navigation": ["./server/shims/next-navigation.ts"],
      "next/head": ["./server/shims/next-head.tsx"],
      "next/dynamic": ["./server/shims/next-dynamic.tsx"],
      "next/font/google": ["./server/shims/next-font.ts"],
      "next/font/local": ["./server/shims/next-font.ts"]
    }
  },
  "include": ["app", "server/shims"],
  "exclude": ["node_modules"]
}
